# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=feonixai

# API server (Next.js stays on 3000 and proxies /api here)
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
NODE_ENV=development

# Server-side OpenAI key. Users never see it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_OUTPUT_TOKENS=400
VISION_MODEL=gpt-4o
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TRANSCRIBE_RESERVE_TOKENS=500

# Signs the session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Unset = open registration for everyone. Set this to require an invite
# code for anyone signing up after the first (owner) account.
SIGNUP_CODE=
DEFAULT_TOKEN_QUOTA=100000

# TRUST_PROXY=1

# Nodemailer / SMTP Config
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fenoix AI" <no-reply@feonixai.com>

# Stripe Payment Integration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PREMIUM_PRICE_ID=price_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

