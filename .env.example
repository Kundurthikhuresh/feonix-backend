# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=feonixai

# API server (Next.js stays on 3000 and proxies /api here)
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
NODE_ENV=development

# Server-side OpenAI key. Users never see it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_OUTPUT_TOKENS=400
VISION_MODEL=gpt-4o
MAX_VISION_OUTPUT_TOKENS=1600
VISION_RESERVE_TOKENS=1800
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TRANSCRIBE_RESERVE_TOKENS=500
MAX_NOTES_TOKENS=900
MAX_ASK_TOKENS=600
# Points the OpenAI SDK at a compatible proxy or local stub instead of the
# real API. Leave unset to use OpenAI directly.
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=30000
# Off by default — the real entitlement gate is the credits system below.
# Set to 1 to also enforce a hard monthly token ceiling per user.
ENFORCE_TOKEN_QUOTA=0

# Signs the session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Unset = open registration for everyone. Set this to require an invite
# code for anyone signing up after the first (owner) account.
SIGNUP_CODE=
DEFAULT_TOKEN_QUOTA=100000
# Free trial interview sessions granted to a new account.
DEFAULT_FREE_TRIALS=5

# Custom URL scheme the desktop app registers for the web->desktop session
# handoff (feonixai://launch?token=...). Must match desktop-electron's
# DESKTOP_SCHEME if that's ever overridden.
DESKTOP_SCHEME=feonixai

# Production Desktop App Download URLs
# (Direct download links hosted on GitHub Releases, AWS S3, or Cloudflare R2)
WINDOWS_DOWNLOAD_URL=https://github.com/Kundurthikhuresh/feonix-frontend/releases/download/v0.2.0/FeonixAI.Setup.0.2.0.exe
MAC_DOWNLOAD_URL=

# TRUST_PROXY=1

# Nodemailer / SMTP Config
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fenoix AI" <no-reply@feonixai.com>

# Razorpay Payment Integration
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
# Amounts in paise (INR's smallest unit). Optional — defaults match the
# pricing page (₹499 / ₹999) if left unset.
RAZORPAY_PRO_AMOUNT_PAISE=49900
RAZORPAY_PREMIUM_AMOUNT_PAISE=99900
NEXT_PUBLIC_APP_URL=http://localhost:3000

